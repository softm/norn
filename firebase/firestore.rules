rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/projects/{projectId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['schema_version','title','description','activeVariant','frames','targetDuration','revision','updatedAt','variantIds'])
        && request.resource.data.schema_version == 2
        && request.resource.data.title is string && request.resource.data.title.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() <= 6000
        && request.resource.data.activeVariant is string
        && request.resource.data.frames is int && request.resource.data.frames >= 1 && request.resource.data.frames <= 20
        && request.resource.data.targetDuration is number && request.resource.data.targetDuration >= 1 && request.resource.data.targetDuration <= 3600
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.variantIds is list && request.resource.data.variantIds.size() >= 1 && request.resource.data.variantIds.size() <= 12;
      match /variants/{variantId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['schema_version','id','name','settings','audio','scenes'])
          && request.resource.data.schema_version == 2
          && request.resource.data.id == variantId
          && request.resource.data.name is string && request.resource.data.name.size() <= 160
          && request.resource.data.settings is map
          && request.resource.data.audio is map
          && request.resource.data.scenes is list && request.resource.data.scenes.size() <= 120;
      }
    }
    match /users/{uid}/settings/{settingId} {
      allow read, delete: if owner(uid) && settingId == 'defaults';
      allow create, update: if owner(uid) && settingId == 'defaults'
        && request.resource.data.keys().hasOnly(['frames','theme','updatedAt'])
        && request.resource.data.frames is int && request.resource.data.frames >= 1 && request.resource.data.frames <= 20
        && request.resource.data.theme == 'warm'
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
